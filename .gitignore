# --- Local-only context (OneDrive-synced, never on GitHub) ---
/source-files/*
!/source-files/.gitkeep
/HANDOVER.md
/CLAUDE.md
/DECISIONS.md

# Real provisioning target: names the hypervisor and the guest address.
/provisioning/proxmox/provision.toml

# --- Secrets and runtime data ---
.env
*.env.local
/data/
*.log
*.db

# --- Language/tool clutter (harmless if unused) ---
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
node_modules/
dist/
build/
*.tsbuildinfo

# --- Rust build output ---
# `CARGO_TARGET_DIR` is exported out-of-tree for the backend (OneDrive), but the
# provisioner commands in CLAUDE.md do not set it, so this directory is real.
/backend/target/
/provisioning/proxmox/target/

# --- test artefacts ---
/frontend/test-results/
/frontend/playwright-report/
/frontend/blob-report/
/frontend/.shot/

# --- OS/editor ---
.DS_Store
Thumbs.db
