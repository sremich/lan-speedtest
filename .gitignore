# --- Local-only context (OneDrive-synced, never on GitHub) ---
# Working notes. These describe how the project is built, not how it is used,
# and the repository is not the place for them.
/source-files/
/HANDOVER.md
/CLAUDE.md
/DECISIONS.md
/.claude/

# Proxmox provisioning: out of scope for the project. The service is a
# container and a coturn relay; how the guest hosting them comes to exist is a
# separate concern, kept locally rather than shipped as if it were part of this.
/provisioning/proxmox/

# --- Secrets and runtime data ---
.env
*.env.local
/data/
*.log
*.db

# --- Language/tool clutter (harmless if unused) ---
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
node_modules/
dist/
build/
*.tsbuildinfo

# --- Rust build output ---
# Normally out-of-tree via `CARGO_TARGET_DIR`, but ignored here too so a build
# run without it set does not offer the whole target directory up for commit.
/backend/target/

# --- test artefacts ---
/frontend/test-results/
/frontend/playwright-report/
/frontend/blob-report/
/frontend/.shot/

# --- OS/editor ---
.DS_Store
Thumbs.db
