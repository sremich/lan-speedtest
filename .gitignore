# --- Local-only context (OneDrive-synced, never on GitHub) ---
/source-files/*
!/source-files/.gitkeep
/HANDOVER.md
/CLAUDE.md
/DECISIONS.md

# --- Secrets and runtime data ---
.env
*.env.local
/data/
*.log
*.db

