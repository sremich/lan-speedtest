# Copy to .env (gitignored) and fill in. Never a real secret in this file.
#
# Only TURN needs a secret. Everything else is tuning, and every value here
# overrides the matching setting in config/speedtest.toml.

# --- measurement profile -----------------------------------------------------
# One of the [profiles.*] keys in config/speedtest.toml: lan-1g, lan-10g, quick.
SPEEDTEST_PROFILE=lan-1g

# --- server ------------------------------------------------------------------
# Inside the container. TLS and 443 are handled on the host, not here.
SPEEDTEST_BIND=0.0.0.0:8080
# error | warn | info | debug | trace
SPEEDTEST_LOG=info

# --- history ------------------------------------------------------------------
# Where completed runs are stored. Set to an empty value to turn history off
# entirely; the front end hides the link and the endpoints degrade quietly.
SPEEDTEST_HISTORY_DB=/app/data/history.db

# --- TLS ----------------------------------------------------------------------
# The service terminates TLS itself; there is no reverse proxy, because a proxy
# hop would sit inside the very path being measured. Set both or neither —
# exactly one is a startup error rather than a silent fallback to plain HTTP.
# Provisioning sets these automatically after issuing the certificate.
SPEEDTEST_TLS_BIND=0.0.0.0:443
SPEEDTEST_TLS_CERT_FILE=/etc/speedtest/tls/fullchain.pem
SPEEDTEST_TLS_KEY_FILE=/etc/speedtest/tls/privkey.pem

# --- TURN relay (packet-loss stage) ------------------------------------------
# coturn runs natively on the guest, not in this container. Set enabled=true
# only once the relay is actually reachable, or the packet-loss stage is
# stripped from the profile served to the browser.
#
# These credentials are handed to the browser by design — the engine builds the
# RTCPeerConnection client-side, so there is no way to keep them server-only.
# Treat the password as LAN-only and never reuse it anywhere else.
SPEEDTEST_TURN_ENABLED=false
SPEEDTEST_TURN_URI=speed.example.lan:3478
SPEEDTEST_TURN_USER=speedtest
SPEEDTEST_TURN_PASS=changeme


# =============================================================================
# Provisioning only. Read by provisioning/, never by the running service, and
# never baked into the image.
# =============================================================================

# --- Proxmox node -------------------------------------------------------------
# Provisioning drives the node over SSH (pct / pvesh) rather than the REST API,
# so there is no API token. The SSH key is the credential; nothing goes here.
# Set the node address and user in provisioning/proxmox/provision.toml.

# --- TLS: ACME DNS-01 via Cloudflare -----------------------------------------
# These use acme.sh's own variable names so they can be handed to it verbatim.
# The token needs exactly one permission: Zone > DNS > Edit, scoped to the one
# zone you are issuing for. It is written to /root/.acme-dns.env on the guest
# with mode 600 and is never stored anywhere else.
CF_Token=changeme
# Optional; acme.sh discovers these itself if the token can list zones.
# CF_Account_ID=
# CF_Zone_ID=

# Contact address registered with the ACME CA, and the zone to issue for.
# A wildcard is issued as *.DOMAIN plus the bare DOMAIN.
ACME_EMAIL=admin@example.com
ACME_DOMAIN=example.com

# --- container registry -------------------------------------------------------
# Needed only while the GHCR package is private (it inherits the repository's
# visibility). Create a CLASSIC token with the single scope `read:packages`:
#   https://github.com/settings/tokens/new?scopes=read:packages
# Fine-grained tokens have patchy GHCR support; classic is the reliable choice.
# Provisioning runs `docker login` on the guest with these, passing the token on
# stdin so it does not appear in the guest's process list.
GHCR_USER=your-github-username
GHCR_TOKEN=ghp_replace_me

# --- TURN (also consumed by provisioning to render turnserver.conf) ----------
# TURN_REALM defaults to the guest FQDN when unset.
# TURN_USER / TURN_PASS mirror SPEEDTEST_TURN_USER / SPEEDTEST_TURN_PASS above.
